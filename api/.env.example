# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WireGuard gateway
WG_SERVER_PUBKEY=
WG_ENDPOINT=api.conceptsos.com:51820
WG_CLIENT_SUBNET=10.10.0.0/16
WG_GATEWAY_URL=http://wg-gateway.conceptsos-system.svc.cluster.local:8080
WG_GATEWAY_TOKEN=

# Kubernetes
K8S_USERS_NAMESPACE=users
USER_POD_IMAGE=us-central1-docker.pkg.dev/conceptsos-prd/conceptsos/vm:latest
USER_POD_STORAGE_GB=10

# Anthropic
# Preferred: per-user workspace keys (requires Admin API access).
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_WORKSPACE_ID=
# Fallback: single shared key used for every user. V1-degraded mode.
ANTHROPIC_API_KEY=

# Reconcile loop
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_MS=5000
