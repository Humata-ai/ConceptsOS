<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Sign in with Apple. Must also be enabled on the
         App ID in the Apple Developer portal (Capabilities). -->
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>

    <!-- Required so we can install and control our own bundled
         WireGuard tunnel via NETunnelProviderManager. The matching
         extension bundle (ai.humata.ConceptsOS.WGTunnel) also carries
         this entitlement. Must be enabled on the App ID in the Apple
         Developer portal (Capabilities → Network Extensions →
         Packet Tunnel). -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>

    <!-- (No App Group intentionally.) We considered
         group.ai.humata.ConceptsOS for sharing state between the app
         and the packet-tunnel extension, but the wg config we need to
         hand off already crosses the boundary via the
         NETunnelProviderProtocol.providerConfiguration dict, so App
         Groups aren't required. Skipping avoids the extra developer-
         portal registration step (App Group creation isn't exposed on
         the App Store Connect API and would have to be clicked in the
         web UI). -->
</dict>
</plist>
