# Shared control plane config. This is the ONE headscale instance every
# customer's app pod joins. Every value is scoped to the *control plane*,
# not per-customer.

HEADSCALE_SERVER_URL=https://hs.conceptsos.com
HEADSCALE_TLS_LETSENCRYPT_HOSTNAME=hs.conceptsos.com
HEADSCALE_BASE_DOMAIN=vpn.conceptsos.com
