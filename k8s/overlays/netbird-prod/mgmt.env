# NetBird management plane configuration (non-secret).
# Referenced by k8s/base/netbird/management-config-template.yaml.

# Public hostnames — set the DNS A records to the LB IPs after first apply.
NB_MGMT_HOST=nb.conceptsos.com
NB_SIGNAL_HOST=signal.nb.conceptsos.com
NB_TURN_HOST=turn.conceptsos.com

# Private DNS zone served by the mgmt service. Peers get hostnames
# <peer>.netbird.conceptsos.com resolvable only from inside the overlay.
NB_DNS_DOMAIN=netbird.conceptsos.com

# Single-account mode: everyone signing in from this Google Workspace
# domain lands in the same NetBird account.
NB_SINGLE_ACCOUNT_DOMAIN=humata.ai

# Overlay CIDR. Disjoint from Headscale's 100.64.0.0/10 so both stacks
# coexist during cutover.
NB_OVERLAY_CIDR=100.92.0.0/16

# OIDC (non-secret parts).
OIDC_ISSUER=https://accounts.google.com
OIDC_DOMAIN=accounts.google.com
