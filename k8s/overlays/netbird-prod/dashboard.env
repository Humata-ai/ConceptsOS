# NetBird dashboard runtime config. These get baked into the SPA at
# container start via the upstream image's envsubst step.

# Where the SPA calls the management API.
NETBIRD_MGMT_API_ENDPOINT=https://nb.conceptsos.com
NETBIRD_MGMT_GRPC_API_ENDPOINT=https://nb.conceptsos.com:33073

# OIDC — must match k8s/overlays/netbird-prod/oidc.env for the SPA
# side of the flow.
AUTH_AUTHORITY=https://accounts.google.com
AUTH_SUPPORTED_SCOPES=openid profile email offline_access
AUTH_REDIRECT_URI=/auth
AUTH_SILENT_REDIRECT_URI=/silent-auth
# Filled in by kustomize edit after you create the OAuth client:
AUTH_CLIENT_ID=REPLACE_ME
AUTH_AUDIENCE=REPLACE_ME
USE_AUTH0=false
