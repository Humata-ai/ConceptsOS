# Copy to oidc.env (gitignored) and fill in with real values from the
# `humata.ai` GCP project (Google Workspace OIDC client + service account).
#
# See docs/netbird-migration.md §Authentication / SSO Migration.

OIDC_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
OIDC_CLIENT_SECRET=GOCSPX-...

# Google Workspace customer ID (Admin console → Account settings).
GOOGLE_CUSTOMER_ID=Cxxxxxxx

# Service account JSON with domain-wide delegation for:
#   admin.directory.user.readonly, admin.directory.group.readonly
# NetBird expects this **base64-encoded**:
#   base64 -w0 < netbird-directory-sync.json
GOOGLE_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi... (base64)
