# Single source of truth for per-deployment config.
# To reuse this repo for a different customer / domain, edit these three
# values (and the `images:` block in kustomization.yaml) — nothing else.

# Public URL of the headscale endpoint. Must match a DNS name that resolves
# to the LoadBalancer's external IP.
HEADSCALE_SERVER_URL=https://hs.conceptsos.com

# Same hostname, used by headscale's built-in ACME client to request a
# Let's Encrypt cert. Leave blank to disable TLS (plain HTTP on :8080).
HEADSCALE_TLS_LETSENCRYPT_HOSTNAME=hs.conceptsos.com

# Hostname this pod registers as inside its own tailnet.
TS_HOSTNAME=conceptsos-app

# MagicDNS suffix. Each tailnet member is reachable at
# <its-hostname>.$HEADSCALE_BASE_DOMAIN from any peer. Should be a domain
# you own but do NOT publish public A records under (headscale intercepts
# resolution inside the tailnet only). MUST differ from the domain in
# HEADSCALE_SERVER_URL.
HEADSCALE_BASE_DOMAIN=ts.conceptsos.com
