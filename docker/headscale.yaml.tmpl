# Rendered by entrypoint.sh via envsubst. Env vars used:
#   HEADSCALE_SERVER_URL, HEADSCALE_LISTEN_ADDR, HEADSCALE_METRICS_ADDR,
#   HEADSCALE_DB_PATH, HEADSCALE_NOISE_KEY, HEADSCALE_PRIVATE_KEY

server_url: ${HEADSCALE_SERVER_URL}
listen_addr: ${HEADSCALE_LISTEN_ADDR}

# TLS. When HEADSCALE_TLS_LETSENCRYPT_HOSTNAME is set, headscale runs its
# own ACME client against Let's Encrypt for that hostname. Cert cache lives
# on the state volume so restarts don't re-issue. Requires port 80 reachable
# for the HTTP-01 challenge and (typically) port 443 for the TLS server.
tls_letsencrypt_hostname: ${HEADSCALE_TLS_LETSENCRYPT_HOSTNAME}
tls_letsencrypt_cache_dir: ${HEADSCALE_TLS_CACHE_DIR}
tls_letsencrypt_challenge_type: ${HEADSCALE_TLS_CHALLENGE_TYPE}
tls_letsencrypt_listen: ":${HEADSCALE_ACME_HTTP_PORT}"
tls_cert_path: "${HEADSCALE_TLS_CERT_PATH}"
tls_key_path: "${HEADSCALE_TLS_KEY_PATH}"
metrics_listen_addr: ${HEADSCALE_METRICS_ADDR}
grpc_listen_addr: 127.0.0.1:50443
grpc_allow_insecure: false

noise:
  private_key_path: ${HEADSCALE_NOISE_KEY}

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: true
    region_id: 999
    region_code: "conceptsos"
    region_name: "ConceptsOS embedded DERP"
    stun_listen_addr: "0.0.0.0:3478"
    private_key_path: ${HEADSCALE_DERP_KEY}
  urls: []
  paths: []
  auto_update_enabled: false

disable_check_updates: true
ephemeral_node_inactivity_timeout: 30m

database:
  type: sqlite
  sqlite:
    path: ${HEADSCALE_DB_PATH}

log:
  format: text
  level: info

dns:
  magic_dns: true
  # Suffix appended to each machine's hostname. MUST be different from the
  # headscale server_url domain so the two DNS scopes don't collide.
  # Machines end up reachable as <hostname>.${HEADSCALE_BASE_DOMAIN} from
  # inside the tailnet only — the domain has no public A records.
  base_domain: ${HEADSCALE_BASE_DOMAIN}
  nameservers:
    global:
      - 1.1.1.1
      - 8.8.8.8

policy:
  mode: file
  path: ""
